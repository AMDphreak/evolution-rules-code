repo "https://github.com/amdphreak/equivalence-rules-code"
ruleset "Astro 4.0 to 5.0" {
    aliases "4.1" "4.2" "4.3" "4.4" "4.5" "4.6" "4.7" "4.8" "4.9" "4.10" "4.11" "4.12" "4.13" "4.14" "4.15"
    
    replace "import { ViewTransitions } from 'astro:transitions'" "import { ClientRouter } from 'astro:transitions'"
    replace "<ViewTransitions />" "<ClientRouter />"
    
    warn "Astro.glob(" "Astro.glob() is deprecated in v5.0. Migrate to import.meta.glob()."
}

