repo "https://github.com/amdphreak/equivalence-rules-code"
ruleset "PyQt 6.0 to 6.1" {
    aliases "6.0.1" "6.0.2"
    
    // Stabilization of initial 6.0 features.
    note "PyQt6" "PyQt6 6.0 introduced the biggest breaking changes (Fully qualified enums). Ensure early 6.0 projects follow this."
}

