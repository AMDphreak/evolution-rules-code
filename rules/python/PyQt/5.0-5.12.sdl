repo "https://github.com/amdphreak/equivalence-rules-code"
ruleset "5.0 to 5.12" {
    aliases "5.0" "5.1" "5.2" "5.3" "5.4" "5.5" "5.6" "5.7" "5.8" "5.9" "5.10" "5.11"

    // WebEngine/Charts split in 5.12
    warn "QtWebEngine" "QtWebEngine was moved to a separate package in PyQt 5.12+. Run 'pip install PyQtWebEngine'."
    warn "QtChart" "QtChart was moved to a separate package in PyQt 5.12+. Run 'pip install PyQtChart'."
    warn "QtDataVisualization" "QtDataVisualization was moved to a separate package in PyQt 5.12+. Run 'pip install PyQtDataVisualization'."
}

